@ARTICLE{Baker2025,
	author = {Baker, Lucy H.},
	title = {Governing rural electrification in Senegal: of monopolies, mini grids and beyond},
	year = {2025},
	journal = {Environmental Research: Infrastructure and Sustainability},
	volume = {5},
	number = {4},
	pages = {},
	doi = {10.1088/2634-4505/ae1163},
	url = {https://www.scopus.com/pages/publications/105020455151?origin=resultslist},
	affiliations = {Geography and Environment, The Open University, Milton Keynes, United Kingdom; University of Johannesburg, Trilateral Research Chair in Transformative Innovation and Sustainable Development, Johannesburg, South Africa},
	abstract = {Despite major progress in electricity access and renewable energy deployment over recent decades, Senegal continues to face challenges in achieving universal rural electrification, a country where 55% of the rural population lack access. A core issue is the absence of a coherent regulatory framework for rural electrification. Initiatives are fragmented, often pursue competing priorities, and involve a complexity of different actors and institutions. Within this context, mini grids have been promoted by donors and international organisations as a promising solution, and Senegal was once considered a regional leader in this sector. Today, most planned projects are solar or solar–diesel hybrid, as compared to the original diesel-generated systems. However, not only are a significant portion of the previously installed projects presumed to no longer be operational, but their actual and projected contribution to Senegal’s rural electrification rate is relatively small. In the case of mini grids more specifically, there have been inconsistencies with regards to licensing, tariff-setting and arrangements for the arrival of the main grid. Processes and standards for their installation, operation, maintenance and ownership have been carried out in a somewhat haphazard way. Despite the introduction of regulation intended to support an increased role for the private sector in the electricity sector more generally, most mini grids that have been developed to date have been government-owned and donor-funded. Private sector involvement has been largely confined to engineering, procurement, and construction, and operation and maintenance. With this in mind, this paper critically examines the political, institutional, and regulatory barriers to rural electrification in Senegal. It highlights the tension between grid extension and the introduction of decentralised/off-grid systems, finding a significant mismatch between donor ideals and expectations on the one hand and the preferences of the state utility, as well as national and local governments on the other. © 2025 The Author(s). Published by IOP Publishing Ltd.},
	author_keywords = {electricity; governing; mini grid; monopolies; off-grid; rural electrification},
	correspondence_address = {L.H. Baker; Geography and Environment, The Open University, Milton Keynes, United Kingdom; email: Lucy.Baker@open.ac.uk},
	publisher = {Institute of Physics},
	issn = {26344505},
	language = {English},
	abbrev_source_title = {Environ. Res. Infrastruct. Sustain.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Akil20251679,
	author = {Akil, Murat and Senyapar, Hafize Nurgul Durmus and Bayindir, Ramazan},
	title = {Renewable Energy Investments in Rural Areas: Socio-Economic Impacts, Governance, and Migration Dynamics},
	year = {2025},
	journal = {14th International Conference on Renewable Energy Research and Applications, ICRERA 2025},
	pages = {1679 - 1690},
	doi = {10.1109/ICRERA66237.2025.11283916},
	url = {https://www.scopus.com/pages/publications/105032913731?origin=resultslist},
	affiliations = {Selcuk University, Konya, Turkey; Gazi University, Ankara, Turkey},
	abstract = {Renewable energy investments in rural areas extend far beyond environmental or technical outcomes, generating transformative socio-economic impacts. This study examines the impact of renewable energy initiatives on rural development, livelihoods, and migration dynamics, employing a qualitative exploratory design and document analysis, supported by MAXQDA-based thematic coding. Drawing on peer-reviewed literature, international development reports, and policy documents, the analysis identifies five critical impact domains: economic development and income gains, gender and social inclusion, rural attractiveness and migration dynamics, land use and equity risks, and institutional design for local value creation. Evidence from Africa, Latin America, and Europe illustrates that decentralized solar mini-grids and community wind projects can quadruple household incomes, stimulate small business growth, and empower women entrepreneurs, while also reducing outmigration when implemented inclusively. Conversely, poorly governed large-scale projects-such as the Lake Turkana wind initiative-have triggered displacement, 'green grabbing,' and community resistance. The findings emphasize that governance models, participatory planning, and fair benefit-sharing are decisive in shaping whether renewable energy stabilizes rural populations or exacerbates inequalities. To achieve just and resilient rural futures, integrated policy frameworks must link energy justice, migration-sensitive strategies, and local ownership. By positioning renewable energy as a catalyst for rural transformation, this study provides actionable insights for policymakers, practitioners, and researchers engaged in sustainable energy transitions. © 2025 IEEE.},
	author_keywords = {energy access; equitable benefit distribution; governance models; qualitative exploratory analysis with MAXQDA; renewable energy investments; rural-urban migration; socio-economic impacts},
	keywords = {Economic analysis; Economic and social effects; Energy economics; Energy policy; Investments; Regional planning; Renewable energy; Sustainable development; Benefits distribution; Energy access; Equitable benefit distribution; Exploratory analysis; Governance models; Migration dynamics; Qualitative exploratory analyze with MAXQDA; Renewable energy investments; Rural-urban migration; Socio-economic impacts; Rural areas},
	correspondence_address = {M. Akil; Selcuk University, Konya, Turkey; email: murat.akil@selcuk.edu.tr},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159989-8},
	language = {English},
