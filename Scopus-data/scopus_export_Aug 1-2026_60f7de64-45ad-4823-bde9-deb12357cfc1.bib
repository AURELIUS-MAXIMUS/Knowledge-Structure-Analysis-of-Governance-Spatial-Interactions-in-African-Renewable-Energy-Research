	keywords = {Economic and social effects; Economics; Electric utilities; Energy development; Energy economics; Energy policy; Green development; Public health; Rural areas; Solar energy; Sustainable development; Sustainable development goals; Time series analysis; Cameroon; Cameroon energy policy; Energy; Energy transitions; Off-grid solar; Off-grid solar system; Policy driven; Renewable energies; Renewable energy integrations; Socio-economic impact assessment; Energy transition},
