	title = {The hybrid renewable energy community approach (HyRECA): Synergising electricity access with bush encroachment mitigation in rural Southern Africa},
	year = {2026},
	journal = {Renewable and Sustainable Energy Transition},
	volume = {9},
	pages = {},
	doi = {10.1016/j.rset.2025.100136},
	url = {https://www.scopus.com/pages/publications/105027941051?origin=resultslist},
	affiliations = {ECRI, Deggendorf Institute of Technology, Max-Breiherr-Str. 32, Pfarrkirchen, 84347, Germany; ENS, Technical University of Munich, Lichtenbergstr. 4a, Garching b, München, 85748, Germany; ORI, University of Botswana, Sexaxa, Shorobe Road, Private Bag 285, Maun, Botswana; School for Climate Studies, Stellenbosch University, 20 Merriman Avenue, Stellenbosch, 7600, South Africa; Faculty of Sciences, Botswana International University of Science & Technology, Private Bag 16, Palapye, Botswana; HySON – Institut für Angewandte Wasserstoffforschung Sonneberg gGmbH, Dammstraße 1, Sonneberg, 96515, Germany; InES, Technische Hochschule Ingolstadt, Esplanade 10, Ingolstadt, 85049, Germany},
	abstract = {Rural electrification and bush encroachment in Southern Africa have long been studied separately. Research shows that hybrid renewable energy systems (HRES) offer viable solutions for off-grid communities, and bush encroachment mitigation is widely recognised as an ecological priority. Using Jamataka, Botswana, as a case study, this study integrates both, asking under which conditions encroacher bush-based HRES are economically viable, which electricity access levels local populations can afford, and whether biomass utilisation contributes to mitigation. Findings indicate strong potential for bush-based HRES in off-grid areas, but competitiveness declines where low-cost grid electricity is available. Economic viability is examined through levelised cost of electricity (LCOE) across alternative HRES configurations. HOMER Pro® simulations indicate PV/biomass/battery systems are most cost-effective off-grid, achieving 100 % renewable fractions, near zero CO₂ emissions, and LCOE of 0.246 $/kWh. In grid-connected contexts without feed-in, PV/diesel/grid combinations dominate (LCOE 0.117 $/kWh) due to low tariffs, but with higher emissions. A novel affordability analysis using household willingness to pay and the World Bank Multi-Tier Framework indicates that all households reach at least Tier 3 electricity access under grid-connected systems and '70 % off-grid, supporting household-use of medium-power appliances. Sustainable biomass extraction clears ∼12 ha annually (∼120 t) in Jamataka, aiding bush encroachment mitigation. Upscaling indicates potential to electrify 1.35 million people in '900 bush-encroached villages across Botswana, Namibia, and South Africa, using '1 % of encroached land – highlighting significant untapped potential. Future research should validate findings through geospatial modelling with high-resolution biomass data and spatially sensitive biomass cost models for region-wide planning. Copyright © 2025. Published by Elsevier Ltd.},
	author_keywords = {Affordability; Biomass Gasification; Bush Encroachment; Hybrid Renewable Energy Systems; LCOE; Rural Electrification; Southern Africa},
	keywords = {Biomass; Cost effectiveness; Ecology; Electric power system economics; Electric utilities; Electrification; Hybrid power; Affordability; Biomass Gasification; Bush encroachment; Cost of electricity; Energy systems; Hybrid renewable energies; Hybrid renewable energy system; Levelised cost of electricity; Rural electrification; Southern africa; Rural areas},
	correspondence_address = {S.D. James; ECRI, Deggendorf Institute of Technology, Pfarrkirchen, Max-Breiherr-Str. 32, 84347, Germany; email: stuart.james@th-deg.de},
