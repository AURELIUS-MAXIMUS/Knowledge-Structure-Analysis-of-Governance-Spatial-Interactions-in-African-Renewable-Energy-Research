@ARTICLE{Obi2026,
	author = {Obi, Joy Nneamaka and Ojo, Emmanuel and Ujah, Chika Oliver},
	title = {Decentralised renewable energy in sub-Saharan Africa: A critical review of pathways to equitable and sustainable energy transitions},
	year = {2026},
	journal = {Unconventional Resources},
