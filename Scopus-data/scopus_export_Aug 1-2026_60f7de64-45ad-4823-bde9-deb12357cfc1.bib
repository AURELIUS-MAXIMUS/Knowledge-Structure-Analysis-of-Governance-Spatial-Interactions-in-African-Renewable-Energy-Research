	doi = {10.1016/j.esd.2026.102038},
	url = {https://www.scopus.com/pages/publications/105041624663?origin=resultslist},
	affiliations = {College of Humanities and Development Studies, China Agricultural University, Beijing, 100193, China; Department of Rural Development and Regional Planning, Institute of Rural Development Planning, P.O Box 138, Dodoma, Tanzania; Faculty of Humanities and Social Sciences, Mkwawa University College of Education, University of Dar es Salaam, P.O Box 2513, Iringa, Tanzania},
	abstract = {Rural electrification is one of the most important catalysts for improving rural livelihoods. This study examines the association between household electricity access and economic diversification and the different household livelihood outcomes on the Ukerewe Islands, Tanzania. The study employed a mixed-method sequential explanatory design, collecting data through 68 stratified households, 20 semi-structured interviews, focus group discussions and key informant interviews. Data were analyzed using descriptive and inferential statistics and thematic analysis. The findings show the association between electrification and household participation in non-farm income activities. However, distributional analysis reveals income inequality within electrified households, indicating that financial gains are highly concentrated in a small number of well-positioned households rather than evenly distributed. The concentration of non-electrified households in traditional fishing signals a structural mismatch and an underutilized potential for value addition through refrigeration. Qualitative findings further confirmed that the productive use of energy is severely limited by geographic isolation and capital deficits. The study contributes to the sustainable energy literature by illustrating that electrification is an enabling input in an Island economy, but not a driver of livelihood change in isolation. To achieve equitable energy transitions, energy policies should go beyond grid expansion to offer targeted connection subsidies, local enterprise support, and critical cold-chain infrastructure to support the fisheries sector under the specific circumstances. © 2026 International Energy Initiative},
	author_keywords = {Economic diversification; Income diversification; Rural electrification; Rural household livelihood; Tanzania},
	keywords = {East African Lakes; Lake Victoria; Tanzania; Economic analysis; Electric utilities; Electrification; Energy policy; Energy transition; Fisheries; Islanding; Economic diversification; Electricity access; Electricity economics; Income diversification; Rural electrification; Rural household livelihood; Rural households; Rural livelihood; Tanzania; ]+ catalyst; electrification; heterogeneity; household income; income distribution; livelihood; rural area; rural economy; Rural areas},
	correspondence_address = {L. Yu; College of Humanities and Development Studies, China Agricultural University, Beijing, China; email: yulerong@cau.edu.cn},
