	url = {https://www.scopus.com/pages/publications/105032149106?origin=resultslist},
	affiliations = {School of Electrical & Information Engineering, University of the Witwatersrand, 1 Jan Smuts Ave, Gauteng, Johannesburg, 2001, South Africa},
	abstract = {Access to reliable electricity remains a critical challenge in Sub-Saharan Africa, where conventional centralized grids and standalone solar home systems often fail to meet rural energy needs. This paper presents the real-world deployment of a scalable, modular picogrid electrification network in Nomzamo Agricultural Village, South Africa. Using a phased approach, 92.5% of households were electrified. Tier 2 systems provide lighting and mobile phone charging whilst an expanded configuration supports communal refrigeration that addresses the high cost of refrigeration by allowing users to pay a monthly fee of USD 1.50 for 15 L of storage space. Deployment was supported by the Peco Champion community model and a rent-to-own payment structure, enabling users to acquire ownership for USD 5 per month over 12 months. Acceptance was evaluated through combined qualitative and quantitative surveys, revealing that 67.7% of users were satisfied, 26.4% were probably satisfied and 5.9% were dissatisfied. Users also expressed interest in expanding their picogrids as this provides a pathway to cooking electrically which is the most desired functionality. The results demonstrate that modular picogrids, integrated with community engagement and flexible payment schemes, can deliver high electrification coverage, enable productive uses such as refrigeration and form the foundation for bottom-up rural electrification. The paper discusses deployment methodology and challenges, lessons learned and potential strategies for scaling up the presented approach to electrifying Sub-Saharan Africa. © 2026 The Authors},
	author_keywords = {Bottom-up electrification; Community lighting; Community refrigeration; Energy access; Peer-to-peer energy sharing; Picogrid; Rural electrification},
	keywords = {South Africa; Electric utilities; Electrification; Lighting; Mobile telecommunication systems; Refrigeration; Solar buildings; Bottom up; Bottom-up electrification; Community lighting; Community refrigeration; Energy access; Energy sharings; Peer to peer; Peer-to-peer energy sharing; Picogrid; Rural electrification; accessibility; bottom-up approach; rural electrification; rural energy; unmanned vehicle; Rural areas},
