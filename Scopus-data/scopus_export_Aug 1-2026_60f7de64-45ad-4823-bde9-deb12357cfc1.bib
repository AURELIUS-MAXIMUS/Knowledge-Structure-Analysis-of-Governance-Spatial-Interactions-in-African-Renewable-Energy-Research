}

@ARTICLE{Mwale2026,
	author = {Mwale, Vincent and Ngonda, Tiyamike and Nkhoma, Richard and Foden, George and Chikomo, Lavinia and To, Long Seng},
	title = {Experiences and challenges of electric pressure cooking in rural mini grid communities of Malawi with insights from the Bondo Community},
	year = {2026},
	journal = {Energy for Sustainable Development},
	volume = {93},
	pages = {},
	doi = {10.1016/j.esd.2026.102019},
	url = {https://www.scopus.com/pages/publications/105036405924?origin=resultslist},
	affiliations = {Department of Energy Systems Engineering, Faculty of Science, Technology and Innovation, Mzuzu University, Mzuzu, Malawi; School of Mechanical, Industrial & Aeronautical Engineering, Faculty of Engineering and the Built Environment, University of the Witwatersrand, Johannesburg, South Africa; Department of Engineering, Malawi Institute of Technology, Malawi University of Science and Technology, Limbe, Malawi; Centre for Sustainable Transitions: Energy, Environment and Resilience, Department of Geography and Environment, Loughborough University, Loughborough, United Kingdom},
	abstract = {Access to clean cooking remains a very large challenge in Sub-Saharan Africa despite some growth in rural electrification. This study qualitatively examined household adoption of electric cooking through the introduction of electric pressure cookers in the Bondo Community of southern Malawi, a rural area served by a hydro mini grid. Data were collected through cooking demonstrations, household surveys, focus group discussions, interviews, and direct observations, and analysed using narrative thematic analysis supported by descriptive profiling. Findings show that electric pressure cookers (EPCs) were valued for their convenience, efficiency, and potential to reduce reliance on firewood. The use of EPCs also promoted gender inclusion in cooking, which had previously been performed only by women. It also improved households' social status. However, adoption was constrained by the unreliable electricity supply, frequent outages, low voltages, and the high cost of appliances. Although only about half of the distributed cookers were used regularly, households reported faster cooking, lower fuel expenditure, and improved food quality. The study demonstrates that sustained adoption of electric cooking in rural mini-grid contexts requires a reliable power supply and supportive financing mechanisms. Integrating clean cooking solutions into rural electrification planning can improve both household welfare and mini-grid viability, thereby advancing progress toward SDG 7 on universal access to modern energy. © 2026 The Authors},
	author_keywords = {Clean cooking adoption; Electric pressure cooking; Gender and energy; Household energy practices; mini grid electrification; Rural energy transitions},
	keywords = {Malawi; Cooking; Electric utilities; Electrification; Outages; Sustainable development; Clean cooking adoption; Electric pressure; Electric pressure cooking; Energy; Energy transitions; Gender and energy; Household energy; Household energy practice; Mini grid electrification; Mini grids; Pressure cooking; Rural energy; Rural energy transition; gender disparity; household energy; local participation; pressure gradient; qualitative analysis; rural area; Sustainable Development Goal; Rural areas},
