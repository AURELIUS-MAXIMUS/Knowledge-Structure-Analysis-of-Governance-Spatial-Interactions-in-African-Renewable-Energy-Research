@ARTICLE{Ugwoke2021,
	author = {Ugwoke, B. and Sulemanu, S. and Corgnati, S.P. and Leone, P. and Pearce, J.M.},
	title = {Demonstration of the integrated rural energy planning framework for sustainable energy development in low-income countries: Case studies of rural communities in Nigeria},
	year = {2021},
	journal = {Renewable and Sustainable Energy Reviews},
	volume = {144},
