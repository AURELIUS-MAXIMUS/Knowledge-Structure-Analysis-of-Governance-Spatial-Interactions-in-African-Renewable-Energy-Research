@ARTICLE{Falchetta2020255,
	author = {Falchetta, Giacomo and Hafner, Manfred and Tagliapietra, Simone},
	title = {Pathways to 100% Electrification in East Africa by 2030},
	year = {2020},
	journal = {Energy Journal},
	volume = {41},
	number = {3},
	pages = {255 - 281},
	doi = {10.5547/01956574.41.3.gfal},
	url = {https://www.scopus.com/pages/publications/85095117015?origin=resultslist},
	affiliations = {Future Energy Program, FEEM—Fondazione Eni Enrico Mattei and Departmnet of International Economics, Institutions and Development, Cattolica University, Fondazione Eni Enrico Mattei, Corso Magenta 63, Milano, 20123, Italy; Future Energy Program, FEEM—Fondazione Eni Enrico Mattei, SciencesPo—Paris School of International Affairs, The Johns Hopkins University – SAIS Europe; Future Energy Program, FEEM—Fondazione Eni Enrico Mattei, Bruegel, and The Johns Hopkins University–SAIS Europe},
	abstract = {In spite of abundant generation potential, as of 2019 East Africa has an electricity access level of 36%, with over 140 million people without service. Here, a bottom-up geospatial model (OnSSET) is used to estimate least-cost pathways to universal access to electricity by 2030 for different consumption-tier objectives under three regional grid electricity generation mix scenarios. Results suggest median total required investments of $57 and $110 billion for guaranteeing basic (160 and 44 kWh/person/year in urban and rural areas) and moderate—i.e. including potential to enable some productive uses—(423 and 160 kWh/person/year) consumption for newly connected households by 2030, respectively. This corresponds to an average of $5.6 billion/year, and implies median capacity additions of 12.2 GW (59% on-grid, 37% mini-grids, and 4% standalone solutions). At least further $2.7 billion/year in generation capacity are required to satisfy the projected demand growth from already electrified consumers. A grid electricity scenario with 25% lower photovoltaic costs and a higher penetration of renewables reveals to be up to 10% cheaper and 46% less carbon-intensive, while also requiring less up-front investment. To achieve such objectives, investment must be channelled within an enabling policy environment, which we discuss. © 2020 by the IAEE. All rights reserved.},
	author_keywords = {East Africa; Electricity access; electrification modelling; energy scenarios; utilities policy},
	correspondence_address = {G. Falchetta; Future Energy Program, FEEM—Fondazione Eni Enrico Mattei and Departmnet of International Economics, Institutions and Development, Cattolica University, Milano, Fondazione Eni Enrico Mattei, Corso Magenta 63, 20123, Italy; email: giacomo.falchetta@feem.it},
	publisher = {International Association for Energy Economics},
