}

@CONFERENCE{Temesgen2024,
	author = {Temesgen, Adugnaw Lake and Tamele, Basilio Zeloso S. and Ahlgren, Erik O.},
	title = {A High-Resolution Analysis of Electricity Demand for Informed Electrification Planning},
	year = {2024},
	journal = {2024 IEEE PES/IAS PowerAfrica, PowerAfrica 2024},
	pages = {},
	doi = {10.1109/PowerAfrica61624.2024.10759429},
	url = {https://www.scopus.com/pages/publications/85213394954?origin=resultslist},
	affiliations = {School of Electrical and Computer Engineering, Addis Ababa University, Addis Ababa, Ethiopia; Department of Physics Eduardo Mondlane University, Maputo, Mozambique; Earth and Environment Chalmers University of Technology, Department of Space, Gothenburg, Sweden},
	abstract = {Electrification planning necessitates a nuanced understanding of electricity demand. However, previous studies have largely overlooked regional differences and relied on a one-size-fits-all approach to demand estimation. This study aims to examine the spatial distribution of electricity demand across households and community institutions in a developing country context, using Ethiopia as a case for the study. The study employed a multifaceted approach: household demand was estimated using the Multi-Tier Framework (MTF), while the demand for community institutions (healthcare, education facilities, places of worship, and government offices) was estimated using the Remote-Areas Multi-energy systems load Profiles (RAMP) stochastic model. The spatial distribution was visualized using the OnSSET methodology. The findings reveal significant demand heterogeneity, with 64% of households falling within Tier 1 and Tier 2 demand levels assuming all households have electricity access, but 61.3% of currently electrified households exhibit Tier 3 in 2020. Additionally, community institutions exhibited electricity demand patterns, with health facilities requiring the highest average demand (around 2,100 kWh/year), followed by education facilities (400 kWh/year). Insights from these high-resolution demand assessments can inform the selection of cost-optimal electrification technologies (e.g., grid extension, mini-grids, standalone systems) based on the demand patterns of specific communities at local level in Ethiopia. © 2024 IEEE.},
	author_keywords = {community; electricity demand; electrification; geospatial; household; spatial},
	keywords = {Demand response; Community; Demand estimation; Demand pattern; Electricity demands; Ethiopia; Geo-spatial; High resolution analysis; Household; Regional differences; Spatial; Electrification},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-835038938-8},
	language = {English},
	abbrev_source_title = {IEEE PES/IAS PowerAfrica, PowerAfrica},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Zürpel2026,
