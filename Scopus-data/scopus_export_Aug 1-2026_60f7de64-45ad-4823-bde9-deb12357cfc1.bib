	author = {Kemabonta, Tam and Alsanad, Abdulrahman and Leonard, Bryan and Johnson, Nathan G.},
	title = {Nightlights and electricity access: measuring the effectiveness of electrification policies in Nigeria using satellite images},
	year = {2026},
	journal = {Frontiers in Energy Research},
	volume = {14},
