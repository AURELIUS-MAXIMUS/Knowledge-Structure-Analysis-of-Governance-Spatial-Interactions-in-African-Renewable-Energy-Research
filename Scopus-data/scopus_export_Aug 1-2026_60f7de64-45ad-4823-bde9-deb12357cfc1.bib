@ARTICLE{Manyele2026,
	author = {Manyele, Samwel},
	title = {Exploring climate resilience, diversification and rural electrification as mitigation policy measures in Tanzania's energy sector},
	year = {2026},
	journal = {Energy Policy},
	volume = {215},
	pages = {},
	doi = {10.1016/j.enpol.2026.115274},
	url = {https://www.scopus.com/pages/publications/105035407657?origin=resultslist},
	affiliations = {Department of Chemical and Process Engineering, University of Dar es Salaam, P.O. Box 35131, Dar es Salaam, Tanzania},
	abstract = {Tanzania's energy sector lies at the intersection of climate resilience, mitigation and development, balancing the urgent need for expanded access with global commitments under the Paris Agreement. Energy supply is dominated by biomass, which accounts for over 80% of consumption and hydropower, which contributes 35–40% of electricity but is increasingly unreliable due to climate variability. These conditions perpetuate energy poverty, rural–urban disparities and vulnerability to climate shocks. This study examines three strategies—resilience building, diversification and climate-smart rural electrification—as pathways for a sustainable transition. Using a mixed-methods study design combining policy/document review, stakeholder interviews and household surveys, this study assessed institutional dynamics, project experiences and technology potentials. Findings indicate moderate progress in renewable integration and rural electrification, yet household energy efficiency and large-scale diversification remain limited due to weak policies, financing gaps and technical constraints. Solar, wind, biomass and geothermal resources present vast potential but face high costs, regulatory barriers and skills shortages. Achieving NDC targets requires coherent policy frameworks, stronger institutions, expanded financing and localized capacity building. The study concludes that strengthening institutional coordination, renewable financing frameworks and climate-resilient infrastructure planning are essential for Tanzania to meet its NDC commitments while expanding equitable energy access. © 2026 Elsevier Ltd},
	author_keywords = {Climate resilience; Energy diversification; Nationally determined contributions (NDCs); Policy and financing barriers; Renewable energy; Rural electrification; Sustainable development},
	keywords = {Climate change; Electric utilities; Electrification; Energy efficiency; Energy policy; Rural areas; Climate resilience; Energy diversification; Energy sector; Mitigation policies; Nationally determined contribution; Policy and financing barrier; Policy measures; Renewable energies; Rural electrification; Tanzania; Sustainable development},
