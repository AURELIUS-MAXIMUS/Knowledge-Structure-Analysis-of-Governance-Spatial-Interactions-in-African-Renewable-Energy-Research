	note = {Cited by: 34}
}

@ARTICLE{Abebe2026591,
	author = {Abebe, Thomas Ayalew and Sebastian, Semella and Tucho, Gudina Terefe},
	title = {Spatial analysis of human fecal waste in rural Oromia, Ethiopia: biomethane and nutrient recovery potential},
	year = {2026},
	journal = {Environmental Science: Advances},
	volume = {5},
	number = {2},
	pages = {591 - 605},
	doi = {10.1039/d5va00356c},
	url = {https://www.scopus.com/pages/publications/105028108092?origin=resultslist},
	affiliations = {Jimma University, Institute of Health, Department of Environmental Health Sciences and Technology, Jimma, Ethiopia; DBFZ – Deutsches Biomasseforschungszentrum Gemeinnützige, GmbH, Leipzig, Germany},
	abstract = {Sanitation remains a critical development and public-health challenge, particularly in rural Ethiopia, where only 7% of the population has access to safely managed sanitation. This study models the spatial distribution and resource-recovery potential of human feces in rural Oromia, integrating high-resolution population data with experimentally validated methane yields and nutrient contents. Model-based estimates suggest annual feces production of ∼2 million tonnes, corresponding to ∼27.9 PJ of biomethane energy and 7309 t N, 2206 t P, and 4511 t K—equivalent to over 2.6 billion Birr in synthetic fertilizer. Resource potential is spatially uneven, with northeastern and central highlands offering the greatest opportunities for biogas and nutrient recovery. Biogas digesters are best suited to livestock-rich highlands, urine-diverting dry toilets to peri-urban areas, and composting or container-based systems to low-income, nutrient-depleted communities. Adoption, however, is hindered by socio-cultural perceptions, financial constraints, and institutional gaps. Coordinated action across health, water-energy, agriculture, environmental protection, and infrastructure sectors—supported by strong regulation, targeted financing, community engagement, and public-private partnerships—is essential for scaling. With context-specific deployment and institutional support, resource- oriented sanitation technologies can convert human waste into a circular resource that enhances rural energy access, soil fertility, and environmental sustainability; improves public health; and advances progress toward the UN's Sustainable Development Goals. This journal is © The Royal Society of Chemistry, 2026},
	correspondence_address = {T.A. Abebe; Jimma University, Institute of Health, Department of Environmental Health Sciences and Technology, Jimma, Ethiopia; email: ayalewthomas@gmail.com},
	publisher = {Royal Society of Chemistry},
	issn = {27547000},
	language = {English},
	abbrev_source_title = {Environ. Sci. Adv.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

