@ARTICLE{Gebreslassie2022,
	author = {Gebreslassie, Mulualem G. and Cuvilas, Carlos and Zalengera, Collen and To, Long Seng and Baptista, Idalina and Robin, Enora and Bekele, Getachew and Howe, Lorraine and Shenga, Carlos and Macucule, Domingos A. and Kirshner, Joshua and Mulugetta, Yacob and Power, Marcus and Robinson, Sandy and Jones, David and Castán Broto, Vanesa},
	title = {Delivering an off-grid transition to sustainable energy in Ethiopia and Mozambique},
	year = {2022},
