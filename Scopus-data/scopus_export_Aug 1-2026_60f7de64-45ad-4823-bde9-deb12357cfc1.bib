	volume = {101},
	pages = {},
	doi = {10.1016/j.jup.2026.102220},
	url = {https://www.scopus.com/pages/publications/105037466500?origin=resultslist},
	affiliations = {Jadara Research Center, Jadara University, Irbid, 21110, Jordan; Department of Mechanical Engineering, Graphic Era (Deemed to be University), Dehradun, 248002, India; Department of Biosciences, Saveetha School of Engineering. Saveetha Institute of Medical and Technical Sciences, Chennai, 602 105, India; Applied Science Research Center. Applied Science Private University, Amman, Jordan; Beykent University, Electrical Engineering, Ayazağa Mahallesi, Hadım Koruyolu Cd. No:19, Sarıyer /, Istanbul, Turkey; Shinawatra University, Pathum Thani, 12160, Thailand; Department of CSE, Graphic Era Hill University, Graphic Era Deemed to Be University, Dehradun, 248002, India; Department of Mechanical and Production Engineering, Guru Nanak Dev Engineering College, Punjab, Ludhiana, 141006, India; CITDR Lab, Tiako University in Oklahoma, Oklahoma City, OK, United States; Hourani Center for Applied Scientific Research, Al-Ahliyya Amman University, Amman, 19328, Jordan},
	abstract = {This study examines the household-facing dimension of energy security in Cameroon through a 3A-based Energy Accessibility Index (EAI) built on availability, affordability, and acceptability. Using survey data from 500 households collected in 2024 across Yaoundé (urban, n = 200), Bafoussam (semi-urban, n = 150), and Wum (rural, n = 150), and interpreting these findings against national energy-system trends from 2000 to 2022, the paper compares how accessibility constraints differ across settlement types. The results show a clear spatial gradient in composite accessibility: Yaoundé records the highest EAI (0.667), followed by Bafoussam (0.583) and Wum (0.500). Urban households perform better on availability and affordability, whereas rural households show stronger acceptability toward decentralized options but remain constrained by lower service continuity and weaker affordability. Rural respondents also report limited access to training, maintenance, and financing channels, helping explain the gap between willingness to adopt and actual uptake. In urban households, affordability is positively associated with appliance ownership (r = 0.68, p < 0.01), suggesting that accessibility shapes not only connection status but also welfare-enhancing energy use. The study contributes a transparent and replicable household-level diagnostic that reveals which barriers dominate in different contexts. Scientifically, it operationalizes acceptability alongside technical and economic dimensions within a consistent composite framework; societally, it supports differentiated policy pathways, including trust-building and quality assurance for decentralized options in urban areas and affordability-linked hybrid mini-grid strategies in rural settings. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	author_keywords = {3A framework; Cameroon; Energy accessibility index; Energy security; Multilevel assessment; Renewable–non-renewable trade-offs},
	keywords = {Commerce; Economic and social effects; Energy policy; Quality assurance; Rural areas; 3a framework; Accessibility index; Cameroon; Energy; Energy accessibility index; Multi-level assessment; Non-renewable; Renewables; Renewable–non-renewable trade-offs; Trade off; Energy security},
