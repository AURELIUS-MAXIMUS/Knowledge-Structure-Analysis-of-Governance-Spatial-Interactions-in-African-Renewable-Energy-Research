	title = {Feasibility study of hydrokinetic power for energy access in rural South Africa},
	year = {2012},
	journal = {Proceedings of the IASTED Asian Conference on Power and Energy Systems, AsiaPES 2012},
	pages = {433 - 438},
	doi = {10.2316/P.2012.768-071},
