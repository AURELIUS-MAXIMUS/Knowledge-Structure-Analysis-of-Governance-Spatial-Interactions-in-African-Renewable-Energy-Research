	author = {Zuch, Matteo},
	title = {Rural electrification in sub-Saharan Africa: A willingness to pay analysis of electricity access in Kenya},
	year = {2025},
	journal = {Energy Policy},
	volume = {206},
	pages = {},
	doi = {10.1016/j.enpol.2025.114720},
